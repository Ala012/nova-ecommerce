@model IEnumerable<Product>
@{ ViewData["Title"] = "Gestion des produits"; }
<section class="hero small">
	<p class="eyebrow">Administration</p>
	<h1>Produits</h1>
	<p class="lead">Ajouter, modifier ou supprimer les produits du catalogue.</p>
	<div class="row-gap">
		<a class="btn btn-primary" asp-action="CreateProduct">Ajouter un produit</a>
		<a class="btn btn-ghost" asp-action="Categories">Gérer les catégories</a>
		<a class="btn btn-ghost" asp-action="Users">Gérer les utilisateurs</a>
	</div>
</section>
@if (TempData["AdminError"] is string error)
{
	<p class="admin-message error">@error</p>
}
<div class="admin-table-wrap">
	<table class="table admin-table">
		<thead><tr><th>Produit</th><th>Catégorie</th><th>Prix</th><th>Stock</th><th>Actions</th></tr></thead>
		<tbody>
		@foreach (var product in Model)
		{
			<tr>
				<td>@product.Name</td>
				<td>@product.Category?.CategoryName</td>
				<td>@product.Price.ToString("0.00") DT</td>
				<td>@product.QteStock</td>
				<td class="admin-actions">
					<a class="btn btn-ghost" asp-action="EditProduct" asp-route-id="@product.ProductId">Modifier</a>
					<form asp-action="DeleteProduct" asp-route-id="@product.ProductId" method="post" onsubmit="return confirm('Supprimer ce produit ?');">
						<button class="btn btn-danger" type="submit">Supprimer</button>
					</form>
				</td>
			</tr>
		}
		</tbody>
	</table>
</div>
